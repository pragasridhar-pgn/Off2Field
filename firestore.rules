rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile document: only the authenticated owner can read and write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Inspections subcollection
      match /inspections/{inspectionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        
        // Evidence metadata subcollection
        match /evidence/{evidenceId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // Devices register collection
    match /devices/{deviceId} {
      allow read, write: if request.auth != null;
    }
    
    // Deny all other unmatched paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
